# Copy to .env. Do not commit real secrets.
#
# JWT validation: set AUTH0_BYPASS=0 and provide domain + audience (must match
# the Auth0 API Identifier and your VITE_AUTH0_AUDIENCE in the frontend).
# For pytest, tests/conftest.py sets AUTH0_BYPASS=1 automatically.
#
# Default 1 = open routes (e.g. local BFF, or set tests); set 0 in production.
AUTH0_BYPASS=1
# Required when AUTH0_BYPASS=0 — same Custom API identifier as the SPA (e.g. https://overfished-bff).
AUTH0_DOMAIN=dev-6n2vvavwg11rnrx2.us.auth0.com
AUTH0_AUDIENCE=https://overfished-bff
#
# Optional: comma-separated list when the SPA is hosted on a different origin than the API
# CORS_ALLOW_ORIGINS=https://app.example.com

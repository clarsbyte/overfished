# Fixture mode — set to "1" for the live demo, "0" once real APIs are wired.
USE_FIXTURES=1

# Real-mode credentials (only consulted when USE_FIXTURES=0)
# GFW = Global Fishing Watch. The env var name matches the official
# gfw-api-python-client SDK convention. Get a token at:
#   https://globalfishingwatch.org/our-apis/tokens
GFW_API_ACCESS_TOKEN=
# Lag (in days) when pulling AIS Vessel Presence — the dataset is delayed by
# ~96 h, so we query [now-N-1d, now-Nd]. Default 5 keeps us safely inside the
# available window.
GFW_PREFETCH_DAYS_AGO=5
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
CLOUDINARY_URL=
BLAND_API_KEY=
PROTECTED_PLANET_TOKEN=
DEMO_PHONE_NUMBER=

# Existing AIS streaming integration (used by backend/vessel_lookup.py)
AISSTREAM_API_KEY=your-aisstream-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here

# Twilio — required for phone call warnings. https://console.twilio.com
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
# Public base URL where /audio is served — used by Twilio to fetch the MP3.
# When running the API server locally this is always http://localhost:8000/audio
AUDIO_BASE_URL=http://localhost:8000/audio

ANTHROPIC_API_KEY=your-anthropic-key-here
# Free key from https://aisstream.io — required for the AIS lookup tool.
AISSTREAM_API_KEY=your-aisstream-key-here
# Bearer token from https://globalfishingwatch.org/our-apis/ — required for IUU classification.
GFW_API_TOKEN=your-gfw-token-here
# API key from https://elevenlabs.io — required for vessel audio warnings.
ELEVENLABS_API_KEY=your-elevenlabs-key-here
# Twilio — required for phone call warnings. https://console.twilio.com
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
# Public base URL where /audio is served — used by Twilio to fetch the MP3.
# When running the API server locally this is always http://localhost:8000/audio
AUDIO_BASE_URL=http://localhost:8000/audio

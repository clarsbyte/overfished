# Empty = use Vite proxy (/api → http://localhost:8000); set to override.
VITE_API_URL=

# 1 = skip Auth0: same “Log in” gate, local-only session. Set AUTH0_BYPASS=1 on the BFF (root .env) for :8001.
VITE_DEV_FAKE_AUTH=

# Auth0 (SPA) — all three required when VITE_DEV_FAKE_AUTH is off. Vite `envDir` is the monorepo root, so a single root .env is typical.
# Application: Single Page Application. Custom API identifier (not Management /api/v2/): https://overfished-bff
# Add http://localhost:5173 to Callback, Logout, and Web Origins.
# In Auth0: Application → APIs (or API Authorization) — authorize this SPA for the Custom API, or you get
# "Client is not authorized to access resource server https://overfished-bff".
VITE_AUTH0_DOMAIN=dev-6n2vvavwg11rnrx2.us.auth0.com
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://overfished-bff
#
# Empty = Vite dev proxy: /agentapi → http://127.0.0.1:8001 (overfished_api, see README “startup”).
VITE_AGENT_API_URL=

# Empty = use Vite proxy (/api → http://localhost:8000); set to override.
VITE_API_URL=

# BFF for agents + sequence (empty = Vite proxy /agentapi → http://localhost:8001).
VITE_AGENT_API_URL=

# Mapbox GL (also supported at repo root .env with envPrefix MAP_BOX_ in vite.config).
MAP_BOX_TOKEN=

# Set to 1 in CI or when data/local_pipeline is absent — skips public/data symlink only.
# SKIP_DATA_LINK=

# Absolute path to Python with pydantic (optional; defaults to backend/.venv or python3).
# CODEGEN_PYTHON=

# Environment / secrets
.env
.env.local
*.env.backup

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node / Vite / Next.js
node_modules/
dist/
.vite/
.next/
*.tsbuildinfo

# We use pnpm; ignore lockfiles from other package managers so accidental
# `npm install` runs don't drop a divergent lockfile in the repo.
frontend/package-lock.json
frontend/yarn.lock

# Generated artifacts
backend/output/
frontend/src/types/schemas.ts

# GFW prefetch cache — re-generated by `python -m tools.gfw_prefetch`.
# The committed `vessel_tracks_global.fallback.json` is the safety net.
backend/fixtures/vessel_tracks_global.json
backend/fixtures/gfw_metadata.json

# Adding this notes file too — it was attached by chan, working-notes only
gwf_documentation.txt

# Local-only docs and working notes (per chan: do not commit any .md files).
# Note: scope `notice_of_violation.html` to the repo root so the Jinja
# template at backend/documents/templates/notice_of_violation.html is NOT
# matched (different file, same name).
*.md
/globe.gl.txt
/notice_of_violation.html
/heatmap_inspo.png

# Reference clone of jeantimex/flight-path — used for reverse-engineering
# the GPU-instanced flight-path visualization. Working-notes only.
/flight-path-study/

# Claude
.claude/settings.local.json
**/.claude/settings.local.json
**/.claude/

# Next.js auto-generated typings (we use Vite, this file shouldn't be tracked)
frontend/next-env.d.ts

# Raw shark dataset — only the processed shark-heatmap.json is used at runtime.
frontend/public/shark-dataset.xml
frontend/public/shark_dataset/
frontend/scripts/process-shark-shapefile.mjs

# Old/unused alternate backend (we use backend/api/main.py instead)
api/src/overfished_api/routers/ai_call.py
api/tests/test_agent_endpoints.py

# Finetune intermediate artifacts and scripts (not used at runtime)
finetune/data/extracted_rules.jsonl
finetune/src/finetune/extract_from_pdfs.py

# OS
.DS_Store
Thumbs.db

# Local pipeline data / artifacts
data/local_pipeline/raw/*
!data/local_pipeline/raw/.gitkeep
!data/local_pipeline/raw/README.md
data/local_pipeline/output/*
!data/local_pipeline/output/.gitkeep

# Large local archives (do not commit; GitHub 100MB limit)
archive.zip
